[{"url": "https://www.ukrinform.net/rubric-ato/4187935-russian-attack-damages-business-energy-facility-in-vinnytsia-injuring-four.html", "title": "\u0420\u043e\u0441\u0456\u0439\u0441\u044c\u043a\u0456 \u0430\u0432\u0456\u0430\u0443\u0434\u0430\u0440\u0438 \u043f\u043e\u0448\u043a\u043e\u0434\u0438\u043b\u0438 \u0435\u043d\u0435\u0440\u0433\u0435\u0442\u0438\u0447\u043d\u0438\u0439 \u043e\u0431\u2019\u0454\u043a\u0442 \u0443 \u0412\u0456\u043d\u043d\u0438\u0446\u0456, 4 \u043f\u043e\u0440\u0430\u043d\u0435\u043d\u0456", "summary": "\u0420\u043e\u0441\u0456\u0439\u0441\u044c\u043a\u0456 \u0430\u0432\u0456\u0430\u0443\u0434\u0430\u0440\u0438 \u0432\u043d\u043e\u0447\u0456 \u0432\u0440\u0430\u0437\u0438\u043b\u0438 \u0412\u0456\u043d\u043d\u0438\u0446\u044e, \u043f\u043e\u0448\u043a\u043e\u0434\u0438\u0432\u0448\u0438 \u0435\u043d\u0435\u0440\u0433\u0435\u0442\u0438\u0447\u043d\u0438\u0439 \u043e\u0431\u2019\u0454\u043a\u0442, \u0431\u0456\u0437\u043d\u0435\u0441\u2011\u0446\u0435\u043d\u0442\u0440, \u0437\u0443\u043f\u0438\u043d\u043a\u0438 \u0433\u0440\u043e\u043c\u0430\u0434\u0441\u044c\u043a\u043e\u0433\u043e \u0442\u0440\u0430\u043d\u0441\u043f\u043e\u0440\u0442\u0443, \u0442\u0440\u0430\u043c\u0432\u0430\u0439 \u0442\u0430 \u0447\u043e\u0442\u0438\u0440\u0438 \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0456\u043b\u0456. \u0427\u043e\u0442\u0438\u0440\u0438 \u0447\u043e\u043b\u043e\u0432\u0456\u043a\u0438 \u043e\u0442\u0440\u0438\u043c\u0430\u043b\u0438 \u043f\u043e\u0440\u0430\u043d\u0435\u043d\u043d\u044f, \u0442\u0440\u043e\u0454 \u043e\u0442\u0440\u0438\u043c\u0430\u043b\u0438 \u0434\u043e\u043f\u043e\u043c\u043e\u0433\u0443 \u043d\u0430 \u043c\u0456\u0441\u0446\u0456, \u043e\u0434\u0438\u043d \u2014 \u0443 \u043b\u0456\u043a\u0430\u0440\u043d\u044e.", "country": "ukraine", "type": "airstrike", "ts": "2026-11-24T07:46:33"}, {"url": "https://meduza.io/en/news/2026/11/24/russian-strikes-kill-two-in-ukraine-s-zaporizhzhia-injure-dozens", "title": "\u0420\u043e\u0441\u0441\u0456\u0439\u0441\u044c\u043a\u0456 \u0432\u0456\u0439\u0441\u044c\u043a\u0430 \u0432\u0431\u0438\u043b\u0438 \u0434\u0432\u043e\u0445 \u0456 \u043f\u043e\u0440\u0430\u043d\u0438\u043b\u0438 40 \u0443 \u0417\u0430\u043f\u043e\u0440\u0456\u0436\u0436\u0456", "summary": "\u0420\u043e\u0441\u0441\u0456\u0439\u0441\u044c\u043a\u0456 \u0432\u0456\u0439\u0441\u044c\u043a\u0430 \u0430\u0442\u0430\u043a\u0443\u0432\u0430\u043b\u0438 \u0417\u0430\u043f\u043e\u0440\u0456\u0436\u0436\u044f \u0432\u043d\u043e\u0447\u0456 24 \u043b\u0438\u0441\u0442\u043e\u043f\u0430\u0434\u0430, \u0432\u0431\u0438\u0432\u0448\u0438 \u0434\u0432\u043e\u0445 \u043b\u044e\u0434\u0435\u0439 \u0456 \u043f\u043e\u0440\u0430\u043d\u0438\u0432\u0448\u0438 \u043f\u043e\u043d\u0430\u0434 40, \u0441\u0435\u0440\u0435\u0434 \u044f\u043a\u0438\u0445 \u0447\u043e\u0442\u0438\u0440\u0438 \u0434\u0456\u0442\u0438. \u0423\u0434\u0430\u0440 \u0437\u0440\u0443\u0439\u043d\u0443\u0432\u0430\u0432 \u043f\u0440\u0438\u0432\u0430\u0442\u043d\u0438\u0439 \u0431\u0443\u0434\u0438\u043d\u043e\u043a, \u0447\u0430\u0441\u0442\u043a\u043e\u0432\u043e \u043f\u043e\u0448\u043a\u043e\u0434\u0438\u0432 \u043f\u2019\u044f\u0442\u0438\u043f\u043e\u0432\u0435\u0440\u0445\u043e\u0432\u0438\u0439 \u0436\u0438\u0442\u043b\u043e\u0432\u0438\u0439 \u0431\u0443\u0434\u0438\u043d\u043e\u043a \u0442\u0430 \u0456\u043d\u0448\u0456 \u0431\u0430\u0433\u0430\u0442\u043e\u043f\u043e\u0432\u0435\u0440\u0445\u043e\u0432\u0456 \u0442\u0430 \u043f\u0440\u0438\u0432\u0430\u0442\u043d\u0456 \u0431\u0443\u0434\u0438\u043d\u043a\u0438, \u0430 \u0442\u0430\u043a\u043e\u0436 \u0442\u0440\u0430\u043d\u0441\u043f\u043e\u0440\u0442\u043d\u0443 \u0456\u043d\u0444\u0440\u0430\u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u0443.", "country": "", "type": "airstrike", "ts": "2026-11-24T08:16:27"}]