[{"url": "https://meduza.io/en/news/2026/11/23/zelensky-confirms-ukrainian-strike-on-russian-warship-in-libya", "title": "\u0423\u043a\u0440\u0430\u0457\u043d\u0430 \u0437\u043d\u0438\u0449\u0438\u043b\u0430 \u043a\u043e\u0440\u0432\u0435\u0442 \u00ab\u041c\u0435\u0440\u043a\u0443\u0440\u0456\u0439\u00bb \u0442\u0430 \u0433\u0435\u043b\u0456\u043a\u043e\u043f\u0442\u0435\u0440 \u041a\u0430\u201127 \u0443 \u0411\u0435\u043d\u0433\u0430\u0437\u0438 \u0437\u0430 \u0434\u043e\u043f\u043e\u043c\u043e\u0433\u043e\u044e \u0441\u0435\u043c\u0438 \u0434\u0440\u043e\u043d\u0456\u0432", "summary": "\u0423\u043a\u0440\u0430\u0457\u043d\u0441\u044c\u043a\u0456 \u043c\u043e\u0440\u0441\u044c\u043a\u0456 \u0434\u0440\u043e\u043d\u0438 \u0437\u043d\u0438\u0449\u0438\u043b\u0438 \u0440\u043e\u0441\u0456\u0439\u0441\u044c\u043a\u0443 \u043a\u043e\u0440\u0432\u0435\u0442\u0443 \u00ab\u041c\u0435\u0440\u043a\u0443\u0440\u0456\u0439\u00bb \u0443 \u043f\u043e\u0440\u0442\u0443 \u0411\u0435\u043d\u0433\u0430\u0437\u0438, \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u0432\u0448\u0438 \u0441\u0456\u043c \u0431\u0435\u0437\u043f\u0456\u043b\u043e\u0442\u043d\u0438\u043a\u0456\u0432, \u0456 \u0437\u043d\u0438\u0449\u0438\u043b\u0438 \u0431\u043e\u0439\u043e\u0432\u0438\u0439 \u0433\u0435\u043b\u0456\u043a\u043e\u043f\u0442\u0435\u0440 \u041a\u0430\u201127. \u041a\u0440\u0456\u043c \u0442\u043e\u0433\u043e, \u0434\u0440\u043e\u043d\u0438 \u0432\u0434\u0430\u0440\u0438\u043b\u0438 \u043f\u043e \u0440\u043e\u0441\u0456\u0439\u0441\u044c\u043a\u043e\u043c\u0443 \u0441\u0443\u0445\u043e\u043c\u0443 \u0432\u0430\u043d\u0442\u0430\u0436\u043d\u043e\u043c\u0443 \u0441\u0443\u0434\u043d\u0443 \u00ab\u0410\u043d\u0433\u0430\u0440\u0430\u00bb, \u044f\u043a\u0435 \u043f\u0435\u0440\u0435\u0432\u043e\u0437\u0438\u043b\u043e \u043e\u0437\u0431\u0440\u043e\u0454\u043d\u043d\u044f.", "country": "libya", "type": "drone", "ts": "2026-11-23T08:01:54"}]