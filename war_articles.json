[{"url": "https://www.middleeasteye.net/live-blog/live-blog-update/iran-unveils-new-launcher-can-fire-two-missiles-once", "title": "\u0406\u0440\u0430\u043d \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u0432 \u0440\u0430\u043a\u0435\u0442\u043d\u0443 \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0443, \u0449\u043e \u043e\u0434\u043d\u043e\u0447\u0430\u0441\u043d\u043e \u0437\u0430\u043f\u0443\u0441\u043a\u0430\u0454 \u0434\u0432\u0430 \u0440\u0430\u043a\u0435\u0442\u0438", "summary": "\u0406\u0440\u0430\u043d \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u0432 \u043d\u043e\u0432\u0443 \u0440\u0430\u043a\u0435\u0442\u043d\u0443 \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0443, \u0449\u043e \u043e\u0434\u043d\u043e\u0447\u0430\u0441\u043d\u043e \u0437\u0430\u043f\u0443\u0441\u043a\u0430\u0454 \u0434\u0432\u0430 \u0440\u0430\u043a\u0435\u0442\u0438, \u043f\u0440\u043e\u0434\u0435\u043c\u043e\u043d\u0441\u0442\u0440\u0443\u0432\u0430\u0432\u0448\u0438 \u0457\u0457 \u0443 \u043f\u0456\u0434\u0437\u0435\u043c\u043d\u043e\u043c\u0443 \u0431\u0430\u0437\u0438\u0441\u0456 \u043f\u0456\u0434 \u043a\u0435\u0440\u0456\u0432\u043d\u0438\u0446\u0442\u0432\u043e\u043c \u0410\u0445\u043c\u0435\u0434\u0430 \u0412\u0430\u0445\u0456\u0434\u0456 \u0442\u0430 \u041c\u0430\u0434\u0436\u0438\u0434\u0430 \u041c\u0443\u0441\u0430\u0444\u0456 \u0437 \u0406\u0420\u0413\u041a. \u041a\u043e\u043c\u0430\u043d\u0434\u0438\u0440\u0438 \u0437\u0430\u044f\u0432\u0438\u043b\u0438, \u0449\u043e \u043d\u043e\u0432\u0430 \u0441\u0438\u0441\u0442\u0435\u043c\u0430 \u043f\u043e\u0441\u0438\u043b\u0438\u0442\u044c \u043c\u043e\u0436\u043b\u0438\u0432\u043e\u0441\u0442\u0456 \u0406\u0440\u0430\u043d\u0443 \u043f\u0440\u043e\u0442\u0438 \u0432\u043e\u0440\u043e\u0433\u0456\u0432, \u0437\u043e\u043a\u0440\u0435\u043c\u0430 \u0421\u043f\u043e\u043b\u0443\u0447\u0435\u043d\u0438\u0445 \u0428\u0442\u0430\u0442\u0456\u0432.", "country": "iran", "type": "weapons", "ts": "2026-11-22T20:01:58"}, {"url": "https://www.ukrinform.net/rubric-ato/4187482-shahed-drone-strikes-kindergarten-in-kharkiv-several-injured.html", "title": "\u0428\u0430\u0445\u0435\u0434 \u0443\u0434\u0430\u0440\u0438\u0432 \u0434\u0438\u0442\u044f\u0447\u0438\u0439 \u0441\u0430\u0434\u043e\u043a \u0443 \u0425\u0430\u0440\u043a\u043e\u0432\u0456, 4 \u043f\u043e\u0440\u0430\u043d\u0435\u043d\u043e", "summary": "\u0428\u0430\u0445\u0435\u0434\u2011\u0434\u0440\u043e\u043d \u0432\u043b\u0443\u0447\u0438\u0432 \u0443 \u0434\u0438\u0442\u044f\u0447\u0438\u0439 \u0441\u0430\u0434\u043e\u043a \u0443 \u0425\u0430\u0440\u043a\u043e\u0432\u0456, \u0432\u043d\u0430\u0441\u043b\u0456\u0434\u043e\u043a \u0447\u043e\u0433\u043e \u043f\u043e\u0440\u0430\u043d\u0435\u043d\u043e 25\u2011\u0440\u0456\u0447\u043d\u043e\u0433\u043e \u0447\u043e\u043b\u043e\u0432\u0456\u043a\u0430, 66\u2011\u0440\u0456\u0447\u043d\u0443 \u0436\u0456\u043d\u043a\u0443, 86\u2011\u0440\u0456\u0447\u043d\u0443 \u0436\u0456\u043d\u043a\u0443 \u0442\u0430 31\u2011\u0440\u0456\u0447\u043d\u0443 \u0436\u0456\u043d\u043a\u0443, \u0443\u0441\u044c\u043e\u0433\u043e \u0447\u043e\u0442\u0438\u0440\u0438 \u043e\u0441\u043e\u0431\u0438. \u041f\u043e\u0448\u043a\u043e\u0434\u0436\u0435\u043d\u043e \u0431\u0443\u0434\u0456\u0432\u043b\u044e \u0441\u0430\u0434\u043a\u0430 \u0442\u0430 \u0432\u0456\u043a\u043d\u0430 \u0447\u043e\u0442\u0438\u0440\u044c\u043e\u0445 \u0431\u0430\u0433\u0430\u0442\u043e\u043a\u0432\u0430\u0440\u0442\u0438\u0440\u043d\u0438\u0445 \u0431\u0443\u0434\u0438\u043d\u043a\u0456\u0432 \u0443 \u041d\u0454\u043c\u0438\u0448\u043b\u044f\u043d\u0441\u044c\u043a\u043e\u043c\u0443 \u0440\u0430\u0439\u043e\u043d\u0456.", "country": "ukraine", "type": "drone", "ts": "2026-11-22T21:31:45"}]