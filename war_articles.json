[{"url": "https://www.ukrinform.net/rubric-ato/4187291-russian-forces-attack-infrastructure-facilities-in-dnipropetrovsk-region.html", "title": "\u0420\u043e\u0441\u0456\u0439\u0441\u044c\u043a\u0456 \u0432\u0456\u0439\u0441\u044c\u043a\u0430 \u0430\u0442\u0430\u043a\u0443\u0432\u0430\u043b\u0438 \u0456\u043d\u0444\u0440\u0430\u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u0443 \u0432 \u0414\u043d\u0456\u043f\u0440\u043e\u043f\u0435\u0442\u0440\u043e\u0432\u0449\u0438\u043d\u0456 10 \u0440\u0430\u0437\u0456\u0432, \u043f\u043e\u0440\u0430\u043d\u0438\u043b\u0438 5 \u0446\u0438\u0432\u0456\u043b\u044c\u043d\u0438\u0445", "summary": "\u0420\u043e\u0441\u0456\u0439\u0441\u044c\u043a\u0456 \u0432\u0456\u0439\u0441\u044c\u043a\u0430 \u0437\u0434\u0456\u0439\u0441\u043d\u0438\u043b\u0438 \u043f\u043e\u043d\u0430\u0434 10 \u0430\u0442\u0430\u043a \u043d\u0430 \u043f\u2019\u044f\u0442\u044c \u0440\u0430\u0439\u043e\u043d\u0456\u0432 \u0414\u043d\u0456\u043f\u0440\u043e\u043f\u0435\u0442\u0440\u043e\u0432\u0441\u044c\u043a\u043e\u0457 \u043e\u0431\u043b\u0430\u0441\u0442\u0456, \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u044e\u0447\u0438 \u0431\u0435\u0437\u043f\u0456\u043b\u043e\u0442\u043d\u0438\u043a\u0438 \u0442\u0430 \u0430\u0432\u0456\u0430\u0446\u0456\u0439\u043d\u0443 \u0431\u043e\u043c\u0431\u0443, \u0432\u043d\u0430\u0441\u043b\u0456\u0434\u043e\u043a \u0447\u043e\u0433\u043e \u0441\u043f\u0430\u043b\u0430\u0445\u043d\u0443\u043b\u0430 \u043f\u043e\u0436\u0435\u0436\u0430 \u0432 \u041f\u0456\u0449\u0430\u043d\u0446\u0456 \u0442\u0430 \u043f\u043e\u0448\u043a\u043e\u0434\u0436\u0435\u043d\u043e \u0456\u043d\u0444\u0440\u0430\u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u0443 \u0432 \u043a\u0456\u043b\u044c\u043a\u043e\u0445 \u0433\u0440\u043e\u043c\u0430\u0434\u0430\u0445. \u041f\u0456\u0441\u043b\u044f \u0430\u0442\u0430\u043a \u0443 \u0448\u0456\u0441\u0442\u044c\u043e\u0445 \u0440\u0430\u0439\u043e\u043d\u0430\u0445 \u0437\u0430\u0444\u0456\u043a\u0441\u043e\u0432\u0430\u043d\u043e \u043f\u2019\u044f\u0442\u044c \u043f\u043e\u0440\u0430\u043d\u0435\u043d\u0438\u0445 \u0446\u0438\u0432\u0456\u043b\u044c\u043d\u0438\u0445.", "country": "ukraine", "type": "shelling", "ts": "2026-11-22T07:16:23"}, {"url": "https://www.ukrinform.net/rubric-ato/4187288-air-defenses-down-161-of-186-russian-drones-launched-against-ukraine-since-evening.html", "title": "\u0423\u043a\u0440\u0430\u0457\u043d\u0441\u044c\u043a\u0430 \u041f\u041f\u041e \u0437\u0431\u0438\u043b\u0430 161 \u0437 186 \u0440\u043e\u0441\u0456\u0439\u0441\u044c\u043a\u0438\u0445 \u0431\u0435\u0437\u043f\u0456\u043b\u043e\u0442\u043d\u0438\u043a\u0456\u0432", "summary": "\u0423\u043a\u0440\u0430\u0457\u043d\u0441\u044c\u043a\u0456 \u041f\u041f\u041e \u0437\u0431\u0438\u043b\u0438 161 \u0437 186 \u0440\u043e\u0441\u0456\u0439\u0441\u044c\u043a\u0438\u0445 \u0431\u0435\u0437\u043f\u0456\u043b\u043e\u0442\u043d\u0438\u043a\u0456\u0432, \u0437\u0430\u043f\u0443\u0449\u0435\u043d\u0438\u0445 \u0437 \u0440\u0456\u0437\u043d\u0438\u0445 \u043d\u0430\u043f\u0440\u044f\u043c\u043a\u0456\u0432, \u0432\u043a\u043b\u044e\u0447\u0430\u044e\u0447\u0438 \u041e\u0440\u0435\u043d\u0431\u0443\u0440\u0433, \u041a\u0443\u0440\u0441\u044c\u043a \u0442\u0430 \u043e\u043a\u0443\u043f\u043e\u0432\u0430\u043d\u0443 \u041a\u0440\u0438\u043c\u0443. \u041d\u0430 \u0448\u0456\u0441\u0442\u044c\u043e\u0445 \u043c\u0456\u0441\u0446\u044f\u0445 \u0432\u043f\u0430\u043b\u0438 \u0443\u043b\u0430\u043c\u043a\u0438 \u0437\u0431\u0438\u0442\u0438\u0445 \u0434\u0440\u043e\u043d\u0456\u0432, \u0430 \u0430\u0442\u0430\u043a\u0430 \u043f\u0440\u043e\u0434\u043e\u0432\u0436\u0443\u0454\u0442\u044c\u0441\u044f.", "country": "ukraine", "type": "drone", "ts": "2026-11-22T07:16:25"}, {"url": "https://www.pravda.com.ua/eng/news/2026/11/22/8064012/", "title": "\u0420\u043e\u0441\u0456\u044f \u0437\u0430\u043f\u0443\u0441\u0442\u0438\u043b\u0430 186 \u0434\u0440\u043e\u043d\u0456\u0432, \u0417\u0421\u0423 \u0437\u0431\u0438\u043b\u0438 161", "summary": "\u0420\u043e\u0441\u0456\u0439\u0441\u044c\u043a\u0456 \u0432\u0456\u0439\u0441\u044c\u043a\u0430 \u0437\u0430\u043f\u0443\u0441\u0442\u0438\u043b\u0438 186 \u0431\u0435\u0437\u043f\u0456\u043b\u043e\u0442\u043d\u0438\u043a\u0456\u0432, \u0441\u0435\u0440\u0435\u0434 \u044f\u043a\u0438\u0445 72 \u0440\u0435\u0430\u043a\u0442\u0438\u0432\u043d\u0438\u0445, \u0443 \u043d\u0456\u0447 \u043d\u0430 21\u201122 \u043b\u0438\u0441\u0442\u043e\u043f\u0430\u0434\u0430, \u0443 \u043d\u0430\u043f\u0440\u044f\u043c\u043a\u0443 \u0423\u043a\u0440\u0430\u0457\u043d\u0438. \u0423\u043a\u0440\u0430\u0457\u043d\u0441\u044c\u043a\u0430 \u041f\u041f\u041e \u0437\u0431\u0438\u043b\u0430 \u0430\u0431\u043e \u0437\u0430\u0433\u043b\u0443\u0448\u0438\u043b\u0430 161 \u0434\u0440\u043e\u043d, \u0430 \u0443\u043b\u0430\u043c\u043a\u0438 \u0432\u043f\u0430\u043b\u0438 \u0443 18 \u043c\u0456\u0441\u0446\u044f\u0445.", "country": "ukraine", "type": "drone", "ts": "2026-11-22T07:31:56"}]