[{"url": "https://www.ukrinform.net/rubric-ato/4187935-russian-attack-damages-business-energy-facility-in-vinnytsia-injuring-four.html", "title": "\u0420\u043e\u0441\u0456\u0439\u0441\u044c\u043a\u0456 \u0430\u0432\u0456\u0430\u0443\u0434\u0430\u0440\u0438 \u043f\u043e\u0448\u043a\u043e\u0434\u0438\u043b\u0438 \u0435\u043d\u0435\u0440\u0433\u0435\u0442\u0438\u0447\u043d\u0438\u0439 \u043e\u0431\u2019\u0454\u043a\u0442 \u0443 \u0412\u0456\u043d\u043d\u0438\u0446\u0456, 4 \u043f\u043e\u0440\u0430\u043d\u0435\u043d\u0456", "summary": "\u0420\u043e\u0441\u0456\u0439\u0441\u044c\u043a\u0456 \u0430\u0432\u0456\u0430\u0443\u0434\u0430\u0440\u0438 \u0432\u043d\u043e\u0447\u0456 \u0432\u0440\u0430\u0437\u0438\u043b\u0438 \u0412\u0456\u043d\u043d\u0438\u0446\u044e, \u043f\u043e\u0448\u043a\u043e\u0434\u0438\u0432\u0448\u0438 \u0435\u043d\u0435\u0440\u0433\u0435\u0442\u0438\u0447\u043d\u0438\u0439 \u043e\u0431\u2019\u0454\u043a\u0442, \u0431\u0456\u0437\u043d\u0435\u0441\u2011\u0446\u0435\u043d\u0442\u0440, \u0437\u0443\u043f\u0438\u043d\u043a\u0438 \u0433\u0440\u043e\u043c\u0430\u0434\u0441\u044c\u043a\u043e\u0433\u043e \u0442\u0440\u0430\u043d\u0441\u043f\u043e\u0440\u0442\u0443, \u0442\u0440\u0430\u043c\u0432\u0430\u0439 \u0442\u0430 \u0447\u043e\u0442\u0438\u0440\u0438 \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0456\u043b\u0456. \u0427\u043e\u0442\u0438\u0440\u0438 \u0447\u043e\u043b\u043e\u0432\u0456\u043a\u0438 \u043e\u0442\u0440\u0438\u043c\u0430\u043b\u0438 \u043f\u043e\u0440\u0430\u043d\u0435\u043d\u043d\u044f, \u0442\u0440\u043e\u0454 \u043e\u0442\u0440\u0438\u043c\u0430\u043b\u0438 \u0434\u043e\u043f\u043e\u043c\u043e\u0433\u0443 \u043d\u0430 \u043c\u0456\u0441\u0446\u0456, \u043e\u0434\u0438\u043d \u2014 \u0443 \u043b\u0456\u043a\u0430\u0440\u043d\u044e.", "country": "ukraine", "type": "airstrike", "ts": "2026-11-24T07:46:33"}]