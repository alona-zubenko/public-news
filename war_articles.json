[{"url": "https://www.pravda.com.ua/eng/news/2026/11/26/8064719/", "title": "\u0420\u043e\u0441\u0456\u044f \u0432\u0442\u0440\u0430\u0442\u0438\u043b\u0430 2\u202f319 \u0432\u0456\u0439\u0441\u044c\u043a\u043e\u0432\u0438\u0445 \u0437\u0430 \u0434\u043e\u0431\u0443", "summary": "\u0420\u043e\u0441\u0456\u0439\u0441\u044c\u043a\u0456 \u0432\u0456\u0439\u0441\u044c\u043a\u0430 \u0437\u0430 \u043e\u0441\u0442\u0430\u043d\u043d\u044e \u0434\u043e\u0431\u0443 \u0432\u0442\u0440\u0430\u0442\u0438\u043b\u0438 2\u202f319 \u043e\u0441\u0456\u0431 \u2014 \u0443\u0431\u0438\u0442\u0438\u0445 \u0456 \u043f\u043e\u0440\u0430\u043d\u0435\u043d\u0438\u0445, \u0449\u043e \u043f\u0456\u0434\u0432\u0438\u0449\u0438\u043b\u043e \u0457\u0445 \u0437\u0430\u0433\u0430\u043b\u044c\u043d\u0456 \u0432\u0442\u0440\u0430\u0442\u0438 \u0434\u043e 1\u202f645\u202f899 \u043e\u0441\u0456\u0431. \u0414\u0430\u043d\u0456 \u043e\u043f\u0440\u0438\u043b\u044e\u0434\u043d\u0438\u0432 \u0413\u0435\u043d\u0448\u0442\u0430\u0431 \u0417\u0421\u0423, \u0437\u0430\u0437\u043d\u0430\u0447\u0438\u0432\u0448\u0438 \u0442\u0430\u043a\u043e\u0436 \u0432\u0442\u0440\u0430\u0442\u0438 \u0442\u0435\u0445\u043d\u0456\u043a\u0438, \u0432\u043a\u043b\u044e\u0447\u0430\u044e\u0447\u0438 5\u202f278 \u043a\u0440\u0438\u043b\u0430\u0442\u0438\u0445 \u0440\u0430\u043a\u0435\u0442 \u0442\u0430 621\u202f002 \u0431\u0435\u0437\u043f\u0456\u043b\u043e\u0442\u043d\u0438\u0445 \u043b\u0456\u0442\u0430\u043b\u044c\u043d\u0438\u0445 \u0430\u043f\u0430\u0440\u0430\u0442\u0456\u0432.", "country": "russia", "type": "casualties", "ts": "2026-11-26T07:16:29"}, {"url": "https://www.pravda.com.ua/eng/news/2026/11/26/8064727/", "title": "\u0421\u0428\u0410 \u0441\u0445\u0432\u0430\u043b\u0438\u043b\u0438 \u043f\u0440\u043e\u0434\u0430\u0436 \u043e\u0431\u043b\u0430\u0434\u043d\u0430\u043d\u043d\u044f F\u201116 \u0423\u043a\u0440\u0430\u0457\u043d\u0456 \u043d\u0430 621,9 \u043c\u043b\u043d \u0434\u043e\u043b\u0430\u0440\u0456\u0432", "summary": "\u0414\u0435\u0440\u0436\u0430\u0432\u043d\u0438\u0439 \u0434\u0435\u043f\u0430\u0440\u0442\u0430\u043c\u0435\u043d\u0442 \u0421\u0428\u0410 \u0441\u0445\u0432\u0430\u043b\u0438\u0432 \u043f\u043e\u0442\u0435\u043d\u0446\u0456\u0439\u043d\u0443 \u043f\u0440\u043e\u0434\u0430\u0436\u0443 \u043e\u0431\u043b\u0430\u0434\u043d\u0430\u043d\u043d\u044f \u0442\u0430 \u0442\u0435\u0445\u043d\u0456\u0447\u043d\u043e\u0457 \u043f\u0456\u0434\u0442\u0440\u0438\u043c\u043a\u0438 \u0434\u043b\u044f \u0432\u0438\u043d\u0438\u0449\u0443\u0432\u0430\u0447\u0456\u0432 F\u201116 \u0423\u043a\u0440\u0430\u0457\u043d\u0456 \u0432\u0430\u0440\u0442\u0456\u0441\u0442\u044e 621,9 \u043c\u043b\u043d\u202f\u0434\u043e\u043b\u0430\u0440\u0456\u0432. \u0424\u0456\u043d\u0430\u043d\u0441\u0443\u0432\u0430\u043d\u043d\u044f \u043d\u0430\u0434\u0430\u043b\u0438 \u0411\u0435\u043b\u044c\u0433\u0456\u044f, \u0414\u0430\u043d\u0456\u044f, \u041d\u0456\u0434\u0435\u0440\u043b\u0430\u043d\u0434\u0438 \u0442\u0430 \u041d\u043e\u0440\u0432\u0435\u0433\u0456\u044f, \u0430 \u043f\u043e\u0441\u0442\u0430\u0447\u0430\u043d\u043d\u044f \u0437\u0434\u0456\u0439\u0441\u043d\u044e\u0432\u0430\u0442\u0438\u043c\u0435\u0442\u044c\u0441\u044f \u0437\u0430 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043e\u044e JUMPSTART \u0431\u0435\u0437 \u0437\u0430\u043b\u0443\u0447\u0435\u043d\u043d\u044f \u0434\u043e\u0434\u0430\u0442\u043a\u043e\u0432\u0438\u0445 \u0430\u043c\u0435\u0440\u0438\u043a\u0430\u043d\u0441\u044c\u043a\u0438\u0445 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043d\u0438\u043a\u0456\u0432.", "country": "ukraine", "type": "weapons", "ts": "2026-11-26T07:31:41"}]