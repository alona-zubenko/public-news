[{"url": "https://www.middleeasteye.net/live-blog/live-blog-update/irgc-says-it-forced-us-fighter-jet-retreat-hengam-island", "title": "IRGC \u0437\u043c\u0443\u0441\u0438\u043b\u0438 F\u201116 \u0421\u0428\u0410 \u0432\u0456\u0434\u0441\u0442\u0443\u043f\u0438\u0442\u0438 \u0431\u0456\u043b\u044f \u043e\u0441\u0442\u0440\u043e\u0432\u0430 \u0425\u0435\u043d\u0433\u0430\u043c", "summary": "\u0406\u0440\u0430\u043d\u0441\u044c\u043a\u0456 \u043f\u0456\u0434\u0440\u043e\u0437\u0434\u0456\u043b\u0438 \u0406\u0440\u0430\u043d\u0441\u044c\u043a\u043e\u0457 \u0440\u0435\u0432\u043e\u043b\u044e\u0446\u0456\u0439\u043d\u043e\u0457 \u0433\u0432\u0430\u0440\u0434\u0456\u0457 (IRGC) \u0430\u043a\u0442\u0438\u0432\u0443\u0432\u0430\u043b\u0438 \u043f\u0440\u043e\u0442\u0438\u043f\u043e\u0432\u0456\u0442\u0440\u044f\u043d\u0443 \u0441\u0438\u0441\u0442\u0435\u043c\u0443 \u043d\u0430 \u043f\u0456\u0432\u0434\u0435\u043d\u043d\u043e-\u0441\u0445\u0456\u0434\u043d\u043e\u043c\u0443 \u0443\u0437\u0431\u0435\u0440\u0435\u0436\u0436\u0456 \u043e\u0441\u0442\u0440\u043e\u0432\u0430 \u0425\u0435\u043d\u0433\u0430\u043c, \u0437\u043c\u0443\u0441\u0438\u0432\u0448\u0438 \u0430\u043c\u0435\u0440\u0438\u043a\u0430\u043d\u0441\u044c\u043a\u0438\u0439 \u0432\u0438\u043d\u0438\u0449\u0443\u0432\u0430\u0447 F\u201116 \u0432\u0456\u0434\u0441\u0442\u0443\u043f\u0438\u0442\u0438. \u0421\u0428\u0410 \u043f\u0456\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u043b\u0438, \u0449\u043e \u0457\u0445\u043d\u0456\u0439 \u043b\u0456\u0442\u0430\u043a \u0431\u0443\u0432 \u0437\u043c\u0443\u0448\u0435\u043d\u0438\u0439 \u043f\u043e\u0432\u0435\u0440\u043d\u0443\u0442\u0438\u0441\u044f \u043f\u0456\u0441\u043b\u044f \u043e\u0442\u0440\u0438\u043c\u0430\u043d\u043d\u044f \u043f\u043e\u043f\u0435\u0440\u0435\u0434\u0436\u0443\u0432\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0441\u0438\u0433\u043d\u0430\u043b\u0443.", "country": "usa", "type": "intercept", "ts": "2026-11-27T07:16:18"}]