[{"url": "https://www.pravda.com.ua/eng/news/2026/11/27/8064897/", "title": "\u041b\u0430\u0442\u0432\u0456\u044f \u0432\u0438\u044f\u0432\u0438\u043b\u0430 \u0431\u0435\u0437\u043f\u0456\u043b\u043e\u0442\u043d\u0438\u043a, \u041d\u0410\u0422\u041e \u0432\u0456\u0434\u043f\u0440\u0430\u0432\u0438\u043b\u043e \u043f\u0435\u0440\u0435\u0445\u043e\u043f\u043b\u044e\u0432\u0430\u0447", "summary": "\u0411\u0435\u0437\u043f\u0456\u043b\u043e\u0442\u043d\u0438\u0439 \u0430\u043f\u0430\u0440\u0430\u0442 \u0431\u0435\u0437 \u0456\u0434\u0435\u043d\u0442\u0438\u0444\u0456\u043a\u0430\u0446\u0456\u0457 \u043f\u0440\u043e\u043d\u0438\u043a \u0443 \u043f\u043e\u0432\u0456\u0442\u0440\u044f\u043d\u0438\u0439 \u043f\u0440\u043e\u0441\u0442\u0456\u0440 \u041b\u0430\u0442\u0432\u0456\u0457 \u0432\u043d\u043e\u0447\u0456 26\u201127 \u043b\u0438\u0441\u0442\u043e\u043f\u0430\u0434\u0430, \u0432\u0438\u043a\u043b\u0438\u043a\u0430\u0432\u0448\u0438 \u0442\u0440\u0438\u0432\u043e\u0433\u0443 \u0432 \u043c\u0443\u043d\u0456\u0446\u0438\u043f\u0430\u043b\u0456\u0442\u0435\u0442\u0430\u0445 \u041b\u0443\u0434\u0437\u0438 \u0442\u0430 \u0411\u0430\u043b\u044c\u0432\u0456. \u041f\u0456\u0441\u043b\u044f \u043f\u0456\u0434\u0439\u043e\u043c\u0443 \u0431\u043e\u0439\u043e\u0432\u0438\u0445 \u043b\u0456\u0442\u0430\u043a\u0456\u0432 \u043c\u0456\u0441\u0456\u0457 \u00ab\u0411\u0430\u043b\u0442\u0456\u0439\u0441\u044c\u043a\u0438\u0439 \u043f\u0430\u0442\u0440\u0443\u043b\u044c \u043f\u043e\u0432\u0456\u0442\u0440\u044f\u043d\u043e\u0433\u043e \u043f\u0440\u043e\u0441\u0442\u043e\u0440\u0443\u00bb \u0442\u0430 \u0437\u0430\u043f\u0443\u0441\u043a\u0443 \u043f\u0435\u0440\u0435\u0445\u043e\u043f\u043b\u044e\u0432\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0431\u0435\u0437\u043f\u0456\u043b\u043e\u0442\u043d\u0438\u043a\u0430, \u0437\u0430\u0433\u0440\u043e\u0437\u0430 \u0431\u0443\u043b\u0430 \u0443\u0441\u0443\u043d\u0443\u0442\u0430 \u0434\u043e 03:30.", "country": "", "type": "drone", "ts": "2026-11-27T07:46:25"}, {"url": "https://www.ukrinform.net/rubric-ato/4189128-air-defences-shoot-down-110-of-155-russian-drones-launched-against-ukraine-overnight.html", "title": "\u0423\u043a\u0440\u0430\u0457\u043d\u0441\u044c\u043a\u0456 \u041f\u041f\u041e \u0437\u0431\u0438\u043b\u0438 110 \u0440\u043e\u0441\u0456\u0439\u0441\u044c\u043a\u0438\u0445 \u0434\u0440\u043e\u043d\u0456\u0432 \u043d\u0430\u0434 \u041e\u0440\u0435\u0301\u043b\u043e\u043c \u0456 \u041a\u0443\u0440\u0441\u044c\u043a\u043e\u043c", "summary": "\u0423\u043a\u0440\u0430\u0457\u043d\u0441\u044c\u043a\u0456 \u041f\u041f\u041e, \u043f\u0456\u0434\u0440\u043e\u0437\u0434\u0456\u043b\u0438 \u0417\u0421\u0423 \u0442\u0430 \u0435\u043b\u0435\u043a\u0442\u0440\u043e\u043d\u043d\u0430 \u0431\u043e\u0440\u043e\u0442\u044c\u0431\u0430 \u0437\u0431\u0438\u043b\u0438 110 \u0437 155 \u0437\u0430\u043f\u0443\u0449\u0435\u043d\u0438\u0445 \u0440\u043e\u0441\u0456\u0439\u0441\u044c\u043a\u0438\u0445 \u0434\u0440\u043e\u043d\u0456\u0432, \u0432\u043a\u043b\u044e\u0447\u0430\u044e\u0447\u0438 \u0428\u0430\u0445\u0435\u0434, \u0425\u0435\u0440\u0431\u0435\u0440\u0430 \u0442\u0430 \u041f\u0430\u0440\u043e\u0434\u0456, \u0437 \u043d\u0430\u043f\u0440\u044f\u043c\u043a\u0456\u0432 \u041e\u0440\u0435\u043b, \u041c\u0456\u043b\u043b\u0435\u0440\u043e\u0432\u043e, \u041a\u0443\u0440\u0441\u044c\u043a, \u0428\u0430\u0442\u0430\u043b\u043e\u0432\u043e, \u041f\u0440\u0438\u043c\u043e\u0440\u0441\u044c\u043a\u043e\u2011\u0410\u0445\u0442\u0430\u0440\u0441\u044c\u043a, \u0425\u0432\u0430\u0440\u0434\u0435\u0301\u0439\u0441\u044c\u043a\u0435 (\u041a\u0440\u0438\u043c) \u0442\u0430 \u0414\u043e\u043d\u0435\u0446\u044c\u043a. \u041f\u043e\u0432\u0456\u0442\u0440\u044f\u043d\u0456 \u0443\u0434\u0430\u0440\u0438 \u0432\u043e\u0440\u043e\u0433\u0430 \u0437\u0430\u0444\u0456\u043a\u0441\u043e\u0432\u0430\u043d\u043e \u0443 27 \u043f\u0443\u043d\u043a\u0442\u0430\u0445, \u0430 \u0443\u043b\u0430\u043c\u043a\u0438 \u0437\u0431\u0438\u0442\u0438\u0445 \u0431\u0435\u0437\u043f\u0456\u043b\u043e\u0442\u043d\u0438\u043a\u0456\u0432 \u0432\u0438\u044f\u0432\u043b\u0435\u043d\u043e \u0449\u0435 \u0432 \u0447\u043e\u0442\u0438\u0440\u044c\u043e\u0445 \u043c\u0456\u0441\u0446\u044f\u0445.", "country": "ukraine", "type": "drone", "ts": "2026-11-27T09:02:00"}, {"url": "https://www.ukrinform.net/rubric-ato/4189177-war-update-136-clashes-on-front-line-over-past-day-two-sectors-see-fiercest-fighting.html", "title": "\u0417\u0421\u0423 \u0437\u0430\u0444\u0456\u043a\u0441\u0443\u0432\u0430\u043b\u0438 136 \u0441\u0443\u0442\u0438\u0447\u043e\u043a \u0442\u0430 81 \u0430\u0432\u0456\u0430\u0443\u0434\u0430\u0440\u0456\u0432 \u0440\u043e\u0441\u0456\u0457", "summary": "\u0413\u0435\u043d\u0448\u0442\u0430\u0431 \u0417\u0421\u0423 \u043f\u043e\u0432\u0456\u0434\u043e\u043c\u0438\u0432 \u043f\u0440\u043e 136 \u0441\u0443\u0442\u0438\u0447\u043e\u043a \u043d\u0430 \u043b\u0456\u043d\u0456\u0457 \u0444\u0440\u043e\u043d\u0442\u0443 \u0437\u0430 \u043e\u0441\u0442\u0430\u043d\u043d\u0456 24 \u0433\u043e\u0434\u0438\u043d\u0438, \u043f\u0456\u0434 \u0447\u0430\u0441 \u044f\u043a\u0438\u0445 \u0440\u043e\u0441\u0456\u0439\u0441\u044c\u043a\u0456 \u0432\u0456\u0439\u0441\u044c\u043a\u0430 \u0437\u0434\u0456\u0439\u0441\u043d\u0438\u043b\u0438 81 \u0430\u0432\u0456\u0430\u0443\u0434\u0430\u0440, \u0441\u043a\u0438\u043d\u0443\u043b\u0438 219 \u043a\u0435\u0440\u043e\u0432\u0430\u043d\u0438\u0445 \u0431\u043e\u043c\u0431 \u0456 \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u043b\u0438 7\u202f111 \u043a\u0430\u043c\u0438\u043a\u0430\u0434\u0437\u0435\u2011\u0434\u0440\u043e\u043d\u0456\u0432. \u0423\u043a\u0440\u0430\u0457\u043d\u0441\u044c\u043a\u0456 \u043b\u0456\u0442\u0430\u043a\u0438, \u0440\u0430\u043a\u0435\u0442\u043d\u0456 \u043f\u0456\u0434\u0440\u043e\u0437\u0434\u0456\u043b\u0438 \u0442\u0430 \u0430\u0440\u0442\u0438\u043b\u0435\u0440\u0456\u044f \u0432\u0456\u0434\u043f\u043e\u0432\u0456\u043b\u0438, \u0437\u043d\u0438\u0449\u0438\u0432\u0448\u0438 15 \u0440\u043e\u0441\u0456\u0439\u0441\u044c\u043a\u0438\u0445 \u0446\u0456\u043b\u0435\u0439, \u0441\u0435\u0440\u0435\u0434 \u044f\u043a\u0438\u0445 \u0432\u0456\u0441\u0456\u043c \u0433\u0440\u0443\u043f \u043f\u0435\u0440\u0441\u043e\u043d\u0430\u043b\u0443 \u0442\u0430 \u0448\u0456\u0441\u0442\u044c \u043f\u0443\u043d\u043a\u0442\u0456\u0432 \u0443\u043f\u0440\u0430\u0432\u043b\u0456\u043d\u043d\u044f \u0434\u0440\u043e\u043d\u0430\u043c\u0438.", "country": "ukraine", "type": "airstrike", "ts": "2026-11-27T09:31:37"}, {"url": "https://www.ukrinform.net/rubric-ato/4189129-russian-forces-launch-nearly-60-strikes-on-sumy-region-in-24-hours-injuring-one.html", "title": "\u0420\u043e\u0441\u0456\u0439\u0441\u044c\u043a\u0456 \u0443\u0434\u0430\u0440\u0438 \u043f\u043e \u0421\u0443\u043c\u0441\u044c\u043a\u0456\u0439 \u043e\u0431\u043b\u0430\u0441\u0442\u0456 \u0437\u0430\u0432\u0434\u0430\u043b\u0438 60 \u0443\u0434\u0430\u0440\u0456\u0432, \u043f\u043e\u0440\u0430\u043d\u0438\u043b\u0438 1", "summary": "\u0420\u043e\u0441\u0456\u0439\u0441\u044c\u043a\u0456 \u0432\u0456\u0439\u0441\u044c\u043a\u0430 \u0437\u0434\u0456\u0439\u0441\u043d\u0438\u043b\u0438 \u043c\u0430\u0439\u0436\u0435 60 \u0443\u0434\u0430\u0440\u0456\u0432 \u043f\u043e \u0421\u0443\u043c\u0441\u044c\u043a\u0456\u0439 \u043e\u0431\u043b\u0430\u0441\u0442\u0456 \u0437\u0430 \u0434\u043e\u0431\u0443, \u0432\u043d\u0430\u0441\u043b\u0456\u0434\u043e\u043a \u0447\u043e\u0433\u043e \u043f\u043e\u0440\u0430\u043d\u0435\u043d\u043e 59\u2011\u0440\u0456\u0447\u043d\u0443 \u0436\u0456\u043d\u043a\u0443 \u0432 \u0441\u0435\u043b\u0456 \u0413\u043b\u0443\u0445\u0456\u0432 \u0442\u0430 \u043f\u043e\u0448\u043a\u043e\u0434\u0436\u0435\u043d\u043e \u0436\u0438\u0442\u043b\u043e\u0432\u0456 \u0442\u0430 \u0433\u0440\u043e\u043c\u0430\u0434\u0441\u044c\u043a\u0456 \u0431\u0443\u0434\u0456\u0432\u043b\u0456 \u0432 \u043a\u0456\u043b\u044c\u043a\u043e\u0445 \u0433